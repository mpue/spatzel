#version 450 core

// Brute-force SDF raymarcher, and deliberately so: it evaluates every
// primitive in the edit list for every distance query, with no acceleration
// structure of any kind. That makes it the reference implementation. A faster
// renderer is correct exactly insofar as it reproduces this one.
//
// The scene evaluation and the shading model live in shared includes
// (sdf_scene.glsl, shading.glsl) so the brick bake and the brick marcher run
// the identical code — a second copy would let "reproduces the reference"
// quietly become "agrees with a different implementation".
//
// One source, two targets: the bodies below are identical and only the way
// resources reach the shader differs, because Vulkan GLSL and OpenGL GLSL
// disagree about that and nothing above the RHI seam may care.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#ifdef TARGET_VULKAN
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D uOutput;
layout(push_constant) uniform Uniforms {
    vec4  cameraPosition; // xyz, w = tan(fovY / 2)
    vec4  cameraRight;    // xyz, w = aspect
    vec4  cameraUp;       // xyz, w = time
    vec4  cameraForward;  // xyz
    vec2  resolution;
    int   primitiveCount;
    float padding;
} u;
#else
// OpenGL has no push constants. The backend maps the same byte blob onto a
// uniform block; std140 and the push constant layout agree here because every
// member is a vec4 or sits in the tightly packed 16-byte tail.
layout(binding = 0, rgba16f) uniform writeonly image2D uOutput;
layout(binding = 0, std140) uniform Uniforms {
    vec4  cameraPosition;
    vec4  cameraRight;
    vec4  cameraUp;
    vec4  cameraForward;
    vec2  resolution;
    int   primitiveCount;
    float padding;
} u;
#endif

// The edit list (slot 1), the distance functions and the fold over the list.
#include "sdf_scene.glsl"
// The directional + hemispherical-ambient + point-light shading model.
#include "shading.glsl"

// Soft shadow for the point light, IQ's penumbra estimator: march the scene
// from the hit toward the light and track the smallest ratio of clearance to
// distance travelled. A ray that squeaks past an edge dims proportionally,
// giving a soft penumbra for the cost of one extra march — no shadow map, no
// second pass. This is the reference renderer's own occlusion query; it marches
// the same edit-list field it shades, so the shadow is exact for this path.
//
// The march stops at the light: a point light is not occluded by geometry
// behind it. The start is pushed off the surface along the ray to keep a hit
// from shadowing itself at the very first step.
float pointLightShadow(vec3 hit, vec3 normal, int primitiveCount) {
    const vec3  toLight   = kPointLightPosition - hit;
    const float lightDist = length(toLight);
    const vec3  dir       = toLight / lightDist;

    const float kSharpness = 12.0; // larger = harder-edged penumbra
    float shadow = 1.0;
    float t      = 0.03;           // step off the surface to avoid self-shadow
    for (int i = 0; i < 96; ++i) {
        const float d = sceneDistance(hit + dir * t, primitiveCount);
        if (d < 0.001) {
            return 0.0;            // fully occluded
        }
        shadow = min(shadow, kSharpness * d / t);
        t += clamp(d, 0.01, 0.4);
        if (t >= lightDist) {
            break;                 // reached the light unobstructed
        }
    }
    return clamp(shadow, 0.0, 1.0);
}

void main() {
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(u.resolution.x) || texel.y >= int(u.resolution.y)) {
        return;
    }

    // Normalised device coordinates, y flipped: the seam puts texel (0, 0) at
    // the top-left, while the camera's up axis points the other way.
    vec2 ndc = ((vec2(texel) + 0.5) / u.resolution) * 2.0 - 1.0;
    ndc.y = -ndc.y;

    const float tanHalfFov = u.cameraPosition.w;
    const float aspect     = u.cameraRight.w;

    const vec3 rayOrigin    = u.cameraPosition.xyz;
    const vec3 rayDirection = normalize(u.cameraForward.xyz +
                                        u.cameraRight.xyz * (ndc.x * aspect * tanHalfFov) +
                                        u.cameraUp.xyz * (ndc.y * tanHalfFov));

    // Sphere tracing.
    const int   kMaxSteps    = 192;
    const float kMaxDistance = 90.0;

    float travelled = 0.0;
    Hit   hit;
    hit.distance = 1e9;
    hit.albedo   = vec3(0.8);
    bool  found  = false;

    for (int step = 0; step < kMaxSteps; ++step) {
        const vec3 p = rayOrigin + rayDirection * travelled;
        hit = sceneSdf(p, u.primitiveCount);

        // The threshold widens with distance: a texel covers more world space
        // further out, so demanding a fixed epsilon there only wastes steps.
        const float epsilon = 0.0006 * max(travelled, 1.0);
        if (hit.distance < epsilon) {
            found = true;
            break;
        }
        travelled += hit.distance;
        if (travelled > kMaxDistance) {
            break;
        }
    }

    vec3 colour;
    if (found) {
        const vec3 position = rayOrigin + rayDirection * travelled;
        const vec3 normal   = sceneNormal(position, u.primitiveCount);
        // Start the shadow ray a touch off the surface along the normal, so the
        // penumbra estimator does not read the hit's own zero distance.
        const float shadow = pointLightShadow(position + normal * 0.02, normal,
                                              u.primitiveCount);
        colour = shadeHit(hit.albedo, normal, position, rayDirection, travelled, shadow);
    } else {
        colour = background(rayDirection);
    }

    imageStore(uOutput, texel, vec4(colour, 1.0));
}
