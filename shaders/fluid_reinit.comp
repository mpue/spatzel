#version 450 core

// Level-set redistancing. One iteration per dispatch; the engine runs a few per
// step, ping-ponging the two level-set buffers.
//
// Advection moves the zero contour correctly but does not keep the field a
// distance function: after a few steps the gradient is no longer unit length,
// and a field whose gradient is not unit length is not something a sphere
// tracer may step by. The renderer marches phi directly, so redistancing is not
// cosmetic here — it is what keeps the marching step safe.
//
// Solves the Hamilton-Jacobi equation
//
//     phi_t + sign(phi) * (|grad phi| - 1) = 0
//
// to steady state with a Godunov upwind gradient, which is the discretisation
// that keeps the zero contour from drifting: each axis picks the one-sided
// difference the characteristic actually comes from. The sign is smeared over a
// cell (phi / sqrt(phi^2 + h^2)) so cells sitting on the interface do not
// flip-flop between the two branches.
//
// Pseudo-time has units of length here, so the stable step is a fraction of h.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#define FLUID_PUSH
#define FLUID_PHI_SRC
#define FLUID_PHI_DST
#include "fluid_common.glsl"

void main() {
    const ivec3 id  = ivec3(gl_GlobalInvocationID);
    const int   res = u.control.x;
    if (any(greaterThanEqual(id, ivec3(res)))) {
        return;
    }

    const float h   = u.domain.w;
    const float phi = fluidPhiAt(id, res);
    const float s   = phi / sqrt(phi * phi + h * h);

    float gradSq = 0.0;
    for (int axis = 0; axis < 3; ++axis) {
        ivec3 lo = id;
        ivec3 hi = id;
        lo[axis] -= 1;
        hi[axis] += 1;

        // Outside the domain the field is extended constantly (the clamp inside
        // fluidPhiAt), which makes the one-sided difference vanish there — a
        // zero-gradient extension, the usual choice at a redistancing boundary.
        const float back    = (phi - fluidPhiAt(lo, res)) / h;
        const float forward = (fluidPhiAt(hi, res) - phi) / h;

        float a;
        float b;
        if (s > 0.0) {
            a = max(back, 0.0);
            b = min(forward, 0.0);
        } else {
            a = min(back, 0.0);
            b = max(forward, 0.0);
        }
        gradSq += max(a * a, b * b);
    }

    const float dtau = 0.4 * h; // CFL for the Godunov Hamiltonian
    gPhiDst[fluidCellIndex(id, res)] = phi - dtau * s * (sqrt(gradSq) - 1.0);
}
